# seaward snapshot 1
# The invented shop server again, read without sudo. The kernel hands its packet rules to root
# only, so the report says what it could not read and decides nothing.
### meta
host shop-1
seaward 0.1.1
collector cli
root no
### iptables-version
iptables v1.8.10 (nf_tables)
### ss
udp   UNCONN 0      0          127.0.0.53%lo:53           0.0.0.0:*
udp   UNCONN 0      0                0.0.0.0:111          0.0.0.0:*
tcp   LISTEN 0      4096       127.0.0.53%lo:53           0.0.0.0:*
tcp   LISTEN 0      4096             0.0.0.0:111          0.0.0.0:*
tcp   LISTEN 0      128              0.0.0.0:22           0.0.0.0:*
tcp   LISTEN 0      511              0.0.0.0:80           0.0.0.0:*
tcp   LISTEN 0      511              0.0.0.0:443          0.0.0.0:*
tcp   LISTEN 0      4096           127.0.0.1:8125         0.0.0.0:*
tcp   LISTEN 0      4096             0.0.0.0:5432         0.0.0.0:*
tcp   LISTEN 0      4096             0.0.0.0:6379         0.0.0.0:*
tcp   LISTEN 0      4096             0.0.0.0:8081         0.0.0.0:*
tcp   LISTEN 0      128                 [::]:22              [::]:*
tcp   LISTEN 0      511                 [::]:80              [::]:*
tcp   LISTEN 0      511                 [::]:443             [::]:*
tcp   LISTEN 0      4096                   *:9100               *:*
tcp   LISTEN 0      4096                [::]:5432            [::]:*
tcp   LISTEN 0      4096                [::]:6379            [::]:*
tcp   LISTEN 0      4096                [::]:8081            [::]:*

# seaward snapshot 1
# An invented small web server: ufw on, Docker with nginx published to everyone and
# postgres published to the machine itself only.
### meta
host web-1
seaward 0.1.0
collector cli
root yes
### iptables-version
iptables v1.8.10 (nf_tables)
### iptables-save
# Generated by iptables-save v1.8.10 (nf_tables)
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER - [0:0]
:DOCKER-USER - [0:0]
:ufw-user-input - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -j ufw-user-input
-A FORWARD -j DOCKER-USER
-A FORWARD -o br-7d1e0c2a9b44 -j DOCKER
-A DOCKER -d 172.18.0.2/32 ! -i br-7d1e0c2a9b44 -o br-7d1e0c2a9b44 -p tcp -m tcp --dport 80 -j ACCEPT
-A DOCKER -d 172.18.0.3/32 ! -i br-7d1e0c2a9b44 -o br-7d1e0c2a9b44 -p tcp -m tcp --dport 5432 -j ACCEPT
-A DOCKER-USER -j RETURN
-A ufw-user-input -p tcp -m tcp --dport 22 -j ACCEPT
-A ufw-user-input -p tcp -m multiport --dports 80,443 -m comment --comment "\'dapp_web\'" -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
:DOCKER - [0:0]
-A PREROUTING -m addrtype --dst-type LOCAL -j DOCKER
-A OUTPUT ! -d 127.0.0.0/8 -m addrtype --dst-type LOCAL -j DOCKER
-A POSTROUTING -s 172.18.0.0/16 ! -o br-7d1e0c2a9b44 -j MASQUERADE
-A DOCKER -i br-7d1e0c2a9b44 -j RETURN
-A DOCKER ! -i br-7d1e0c2a9b44 -p tcp -m tcp --dport 8080 -j DNAT --to-destination 172.18.0.2:80
-A DOCKER -d 127.0.0.1/32 ! -i br-7d1e0c2a9b44 -p tcp -m tcp --dport 5432 -j DNAT --to-destination 172.18.0.3:5432
COMMIT
### ip6tables-save
# Generated by ip6tables-save v1.8.10 (nf_tables)
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:ufw6-user-input - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -j ufw6-user-input
-A ufw6-user-input -p tcp -m tcp --dport 22 -j ACCEPT
-A ufw6-user-input -p tcp -m multiport --dports 80,443 -j ACCEPT
COMMIT
